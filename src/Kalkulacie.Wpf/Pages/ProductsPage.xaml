<Page x:Class="Kalkulacie.Desktop.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Výrobky"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Loaded="OnLoaded"
      SizeChanged="OnSizeChanged"
      PreviewKeyDown="OnPagePreviewKeyDown">

    <Page.Resources>
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#D6EEE8" />
        <SolidColorBrush x:Key="HoverRowBrush" Color="#0A000000" />

        <!-- Vlastné šablóny riadku, bunky a hlavičky: výber riadok neposúva, takže čísla ostanú pod sebou. -->
        <Style x:Key="CompactRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <DataGridCellsPresenter />
                            <!-- Fokus klávesnice: rámik okolo vybraného riadku -->
                            <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                    BorderThickness="2" CornerRadius="3" SnapsToDevicePixels="True"
                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactCell" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- Tab tabuľku opúšťa (OnGridPreviewKeyDown); po riadkoch sa chodí šípkami. -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="Transparent" Padding="10,0" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Kompaktná tabuľka len na čítanie: výber celého riadku, Tab tabuľku opustí (šípky chodia po riadkoch). -->
        <Style x:Key="CompactGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <EventSetter Event="PreviewKeyDown" Handler="OnGridPreviewKeyDown" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="RowStyle" Value="{StaticResource CompactRow}" />
            <Setter Property="CellStyle" Value="{StaticResource CompactCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactHeader}" />
        </Style>

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="NumCellStrong" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>


        <!-- Skupina prepínačov je jedna zastávka Tab (vybraná voľba); medzi voľbami sa chodí šípkami. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="380" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- ───────────── Zoznam výrobkov ───────────── -->
        <Border x:Name="ListPane" Grid.Column="0" Style="{StaticResource Pane}" Margin="0,0,0,0">
            <Grid Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Výrobky" Style="{StaticResource PaneTitle}" />

                <ui:TextBox x:Name="ProductSearch" Grid.Row="1" Margin="0,12,0,0"
                            PlaceholderText="Hľadať výrobok…"
                            ClearButtonEnabled="True"
                            AutomationProperties.Name="Hľadať výrobok"
                            ToolTip="Hľadá v názve bez ohľadu na veľkosť písmen a diakritiku (Ctrl+F)"
                            TextChanged="OnProductSearchChanged"
                            PreviewKeyDown="OnProductSearchKeyDown">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6" PreviewKeyDown="OnRadioGroupKeyDown">
                    <TextBlock Text="Typ výroby:" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource Caption}" />
                    <RadioButton IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}" x:Name="FilterAll" GroupName="ModeFilter" Content="Všetky" IsChecked="True"
                                 MinWidth="0" Margin="0,0,14,0" Checked="OnFilterChanged" />
                    <RadioButton IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}" x:Name="FilterManual" GroupName="ModeFilter" Content="Ručná"
                                 MinWidth="0" Margin="0,0,14,0" Checked="OnFilterChanged" />
                    <RadioButton IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}" x:Name="FilterAutomatic" GroupName="ModeFilter" Content="Strojová"
                                 MinWidth="0" Checked="OnFilterChanged" />
                </StackPanel>

                <DataGrid x:Name="ProductsGrid" Grid.Row="3" Style="{StaticResource CompactGrid}"
                          AutomationProperties.Name="Zoznam výrobkov"
                          SelectionChanged="OnProductSelectionChanged"
                          PreviewKeyDown="OnProductsGridKeyDown"
                          MouseDoubleClick="OnProductsGridDoubleClick"
                          PreviewMouseLeftButtonUp="OnProductsGridMouseUp"
                          GotKeyboardFocus="OnGridGotKeyboardFocus">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
                                    <Setter Property="ToolTip" Value="{Binding Name}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Typ" Binding="{Binding ModeText}" Width="82"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Cena" Binding="{Binding Price}" Width="74"
                                            ElementStyle="{StaticResource NumCell}"
                                            HeaderStyle="{StaticResource NumHeader}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="NoProductsText" Grid.Row="3" Visibility="Collapsed"
                           Text="Hľadaniu nevyhovuje žiadny výrobok."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock x:Name="ProductCountText" Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource Caption}" />
            </Grid>
        </Border>

        <!-- ───────────── Detail výrobku ───────────── -->
        <Border x:Name="DetailPane" Grid.Column="1" Style="{StaticResource Pane}" Margin="12,0,0,0"
                GotKeyboardFocus="OnDetailGotKeyboardFocus">
            <Grid>
                <TextBlock x:Name="NoDetailText" Text="Vyberte výrobok zo zoznamu."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Na veľmi širokom okne sa detail ďalej nerozťahuje — názov položky a jej čísla ostanú blízko seba. -->
                <Grid x:Name="DetailContent" Margin="16,14,16,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1040" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hlavička: späť (len v úzkom okne), názov, typ výroby -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="BackButton" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Content="Výrobky" ToolTip="Späť na zoznam výrobkov (Esc)"
                                   AutomationProperties.Name="Späť na zoznam výrobkov"
                                   Click="OnBackClick">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="DetailName" Style="{StaticResource PaneTitle}" />
                            <TextBlock x:Name="DetailSubtitle" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ui:InfoBar x:Name="WarningBar" Grid.Row="1" Margin="0,12,0,0" Severity="Warning"
                                IsClosable="False" IsOpen="False" Title="Skontrolujte zloženie" />

                    <Grid Grid.Row="2" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Zloženie" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ui:Button x:Name="AddMaterialButton" Grid.Column="1" Appearance="Primary"
                                   Content="Pridať materiál" ToolTip="Pridať materiál do zloženia (Ctrl+M)"
                                   Click="OnAddMaterialClick">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Border Grid.Row="3" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <DataGrid x:Name="RowsGrid" Style="{StaticResource CompactGrid}"
                                      AutomationProperties.Name="Zloženie výrobku"
                                      GotKeyboardFocus="OnGridGotKeyboardFocus">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColType" Header="Typ" Binding="{Binding Type}" Width="76" MinWidth="76"
                                                        ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Header="Položka" Binding="{Binding Name}" Width="*" MinWidth="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="MJ" Binding="{Binding Unit}" Width="52" MinWidth="52"
                                                        ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Binding="{Binding Quantity}" Width="84" MinWidth="84"
                                                        ElementStyle="{StaticResource NumCell}"
                                                        HeaderStyle="{StaticResource NumHeader}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Množstvo"
                                                       ToolTip="Materiál: množstvo. Práca: počet kusov, ktorým sa delí sadzba." />
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="ColDimA" Header="Rozmer A" Binding="{Binding DimensionA}" Width="80" MinWidth="80"
                                                        ElementStyle="{StaticResource NumCell}"
                                                        HeaderStyle="{StaticResource NumHeader}" />
                                    <DataGridTextColumn x:Name="ColDimB" Header="Rozmer B" Binding="{Binding DimensionB}" Width="80" MinWidth="80"
                                                        ElementStyle="{StaticResource NumCell}"
                                                        HeaderStyle="{StaticResource NumHeader}" />
                                    <DataGridTextColumn x:Name="ColUnitPrice" Header="Cena / sadzba" Binding="{Binding UnitPrice}" Width="104" MinWidth="104"
                                                        ElementStyle="{StaticResource NumCell}"
                                                        HeaderStyle="{StaticResource NumHeader}" />
                                    <DataGridTextColumn Header="Náklad" Binding="{Binding Cost}" Width="78" MinWidth="78"
                                                        ElementStyle="{StaticResource NumCellStrong}"
                                                        HeaderStyle="{StaticResource NumHeader}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoRowsText" Visibility="Collapsed"
                                       Text="Výrobok zatiaľ nemá zloženie. Začnite tlačidlom Pridať materiál."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Súhrn nákladov a výsledná cena — vždy viditeľné pod tabuľkou -->
                    <Border Grid.Row="4" Margin="0,12,0,0" Padding="16,10" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Materiál" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MaterialTotalText" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Práca" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="OperationTotalText" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="UvnCaption" Text="Vlastné náklady (UVN)" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UvnText" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                <TextBlock x:Name="PriceCaption" Text="Cena" Style="{StaticResource Caption}"
                                           TextAlignment="Right" />
                                <TextBlock x:Name="PriceText" FontSize="24" FontWeight="Bold" TextAlignment="Right"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ───────────── Pravý panel: pridanie materiálu ───────────── -->
        <Border x:Name="MaterialPanel" Grid.Column="2" Style="{StaticResource Pane}" Margin="12,0,0,0"
                Visibility="Collapsed"
                KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="Pridať materiál">
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Pridať materiál" Style="{StaticResource PaneTitle}" />
                        <TextBlock x:Name="PanelSubtitle" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button x:Name="PanelCloseButton" Grid.Column="1" VerticalAlignment="Top" Padding="6"
                               Appearance="Transparent" BorderThickness="0" TabIndex="20"
                               ToolTip="Zavrieť bez uloženia (Esc)"
                               AutomationProperties.Name="Zavrieť panel"
                               Click="OnPanelCancelClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <ui:TextBox x:Name="MaterialSearch" Grid.Row="1" Margin="0,12,0,8" TabIndex="1"
                            PlaceholderText="Hľadať materiál…"
                            ClearButtonEnabled="True"
                            AutomationProperties.Name="Hľadať materiál"
                            ToolTip="Šípky hore/dole vyberajú materiál v zozname"
                            TextChanged="OnMaterialSearchChanged"
                            PreviewKeyDown="OnMaterialSearchKeyDown">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <Border Grid.Row="2" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <DataGrid x:Name="MaterialsGrid" Style="{StaticResource CompactGrid}" TabIndex="2"
                                  AutomationProperties.Name="Zoznam materiálov"
                                  SelectionChanged="OnMaterialSelectionChanged"
                                  GotKeyboardFocus="OnGridGotKeyboardFocus">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Materiál" Binding="{Binding Name}" Width="*" MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="MJ" Binding="{Binding Unit}" Width="52"
                                                    ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Header="Cena" Binding="{Binding PriceText}" Width="82"
                                                    ElementStyle="{StaticResource NumCell}"
                                                    HeaderStyle="{StaticResource NumHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoMaterialsText" Visibility="Collapsed"
                                   Text="Hľadaniu nevyhovuje žiadny materiál."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- Spôsob výpočtu a hodnoty riadku -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" PreviewKeyDown="OnRadioGroupKeyDown">
                        <TextBlock Text="Výpočet:" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource Caption}" />
                        <RadioButton IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}" x:Name="KindPiece" GroupName="RowKind" Content="Kusový" IsChecked="True"
                                     MinWidth="0" Margin="0,0,14,0" TabIndex="3"
                                     ToolTip="Náklad = cena × množstvo × koeficient kusového materiálu"
                                     Click="OnKindClick" />
                        <RadioButton IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}" x:Name="KindArea" GroupName="RowKind" Content="Plošný (A × B)"
                                     MinWidth="0" TabIndex="4"
                                     ToolTip="Náklad = A × B × koeficient plošného materiálu × cena × množstvo"
                                     Click="OnKindClick" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="DimensionAField" Grid.Column="0" Visibility="Collapsed">
                            <TextBlock Text="Rozmer A" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="DimensionABox" TabIndex="5" TextAlignment="Right"
                                        AutomationProperties.Name="Rozmer A"
                                        TextChanged="OnRowValueChanged" GotKeyboardFocus="OnNumberBoxFocus" />
                        </StackPanel>
                        <StackPanel x:Name="DimensionBField" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Text="Rozmer B" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="DimensionBBox" TabIndex="6" TextAlignment="Right"
                                        AutomationProperties.Name="Rozmer B"
                                        TextChanged="OnRowValueChanged" GotKeyboardFocus="OnNumberBoxFocus" />
                        </StackPanel>
                        <StackPanel x:Name="QuantityField" Grid.Column="0">
                            <TextBlock x:Name="QuantityLabel" Text="Množstvo" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="QuantityBox" TabIndex="7" TextAlignment="Right"
                                        AutomationProperties.Name="Množstvo"
                                        TextChanged="OnRowValueChanged" GotKeyboardFocus="OnNumberBoxFocus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Priebežný výpočet ešte pred uložením -->
                <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Náklad riadku" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewCostText" Grid.Row="0" Grid.Column="1" FontSize="16"
                                   FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock x:Name="PreviewFormulaText" Grid.Row="1" Grid.ColumnSpan="2"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cena výrobku po pridaní"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewPriceText" Grid.Row="2" Grid.Column="1" FontSize="16"
                                   FontWeight="SemiBold" TextAlignment="Right"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="PanelErrorText" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed"
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                <Grid Grid.Row="6" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="PanelSaveButton" Grid.Column="0" Appearance="Primary" TabIndex="8"
                               HorizontalAlignment="Stretch" Content="Uložiť" ToolTip="Uložiť riadok (Enter)"
                               Click="OnPanelSaveClick" />
                    <ui:Button x:Name="PanelCancelButton" Grid.Column="2" TabIndex="9"
                               HorizontalAlignment="Stretch" Content="Zrušiť" ToolTip="Zavrieť bez uloženia (Esc)"
                               Click="OnPanelCancelClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
