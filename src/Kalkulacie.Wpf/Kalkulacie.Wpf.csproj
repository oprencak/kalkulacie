<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prototyp nového UI (WPF + WPF UI od Lepoco). Beží vedľa WinForms aplikácie Kalkulacie.App
       a používa ten istý Kalkulacie.Core (entity, migrácie, cenové vzorce). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Menný priestor nesmie byť Kalkulacie.Wpf — kolidoval by s Wpf.Ui v generovanom kóde XAML. -->
    <RootNamespace>Kalkulacie.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Kalkulacie.App\palma.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalkulacie.Core\Kalkulacie.Core.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF z implicitných usingov vyhadzuje System.IO; zdieľaný AppDb.cs ho potrebuje. -->
    <Using Include="System.IO" />

    <!-- Zdieľané s WinForms aplikáciou: výber/otvorenie DB so zálohou a migráciou, hľadanie bez diakritiky. -->
    <Compile Include="..\Kalkulacie.App\AppDb.cs" Link="Shared\AppDb.cs" />
    <Compile Include="..\Kalkulacie.App\TextSearch.cs" Link="Shared\TextSearch.cs" />
    <Resource Include="..\Kalkulacie.App\palma.ico" Link="palma.ico" />
  </ItemGroup>

</Project>
